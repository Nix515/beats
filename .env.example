SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-server-only-service-role-key
PORT=3000
WEB_ORIGIN=http://localhost:3000
MAX_UPLOAD_MB=500
MAX_PROCESSED_MB=100
ADMIN_USER_IDS=replace-with-admin-user-uuid
AUDIT_HASH_SECRET=replace-with-a-long-random-secret
AUDIT_LOG_DIR=./logs
# Optional overrides. The deployment image already includes FFmpeg and FFprobe.
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
